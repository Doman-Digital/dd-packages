{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Explicit rather than relying on automatic @types discovery: this package
    // uses process.env / fetch / URLSearchParams, and TypeScript will happily
    // find an @types/node installed anywhere up the directory tree, so an
    // undeclared dependency typechecks locally and fails on a clean runner.
    "types": ["node"]
  },
  "include": ["src"]
}
