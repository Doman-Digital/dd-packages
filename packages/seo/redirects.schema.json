{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@domandigital/seo/redirects.schema.json",
  "title": "redirects.json",
  "description": "A site's redirect list, read by the framework config and checked by validateRedirects in @domandigital/seo. Exact paths only.",
  "type": "object",
  "required": ["redirects"],
  "properties": {
    "$schema": { "type": "string" },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^/" },
          "to": { "type": "string", "pattern": "^(/|https?://)" },
          "permanent": { "type": "boolean", "default": true },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
