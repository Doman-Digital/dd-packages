{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@domandigital/seo/links.schema.json",
  "title": "links.json",
  "description": "A site's backlink register: links the business has earned, one entry per linking page. Records links that exist or existed, never asks. Types: Backlink in @domandigital/seo.",
  "type": "object",
  "required": ["links"],
  "properties": {
    "$schema": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "url", "targetUrl", "obtainedOn", "rel", "status"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "description": "Who links, in words." },
          "url": { "type": "string", "format": "uri", "description": "The page the link sits on." },
          "targetUrl": { "type": "string", "minLength": 1, "description": "The page on this site it points to." },
          "obtainedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "rel": { "enum": ["follow", "nofollow", "ugc", "sponsored"] },
          "status": { "enum": ["live", "pending", "lost"] },
          "kind": { "enum": ["press", "directory", "register", "supplier", "partner", "community", "other"] },
          "lastCheckedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
