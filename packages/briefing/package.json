{
  "name": "@domandigital/briefing",
  "version": "0.0.0",
  "private": false,
  "description": "The editorial layer of the Doman Digital Client Briefing: classify, dedupe, rank and lint a fortnight of change entries and metrics into a short, true briefing. Pure functions, no dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^20",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doman-Digital/dd-packages.git",
    "directory": "packages/briefing"
  },
  "homepage": "https://github.com/Doman-Digital/dd-packages/tree/main/packages/briefing#readme",
  "bugs": {
    "url": "https://github.com/Doman-Digital/dd-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
