{
  "name": "@domandigital/craft",
  "version": "0.18.1",
  "private": false,
  "description": "The Doman Digital house craft standard as numbers: OKLCh colour ramps that snap to existing anchors, derived semantic tokens with measured WCAG and APCA contrast, one shared motion vocabulary for CSS and JS, and a base stylesheet. Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./css/*.css"
  ],
  "bin": {
    "craft": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./audit": {
      "import": {
        "types": "./dist/audit.d.ts",
        "default": "./dist/audit.js"
      },
      "require": {
        "types": "./dist/audit.d.cts",
        "default": "./dist/audit.cjs"
      }
    },
    "./package.json": "./package.json",
    "./craft.css": "./css/craft.css",
    "./craft.tailwind.css": "./css/craft.tailwind.css",
    "./art-direction.schema.json": "./art-direction.schema.json"
  },
  "files": [
    "CHANGELOG.md",
    "art-direction.schema.json",
    "CHARACTER.md",
    "COPY.md",
    "LICENSE",
    "PRINCIPLES.md",
    "README.md",
    "REGISTERS.md",
    "STANDARD.md",
    "word-lists.json",
    "licences.json",
    "css",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "docs": "tsup && node scripts/write-catalogue.mjs && node scripts/write-word-lists.mjs && node scripts/write-licences.mjs && node scripts/write-registers.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doman-Digital/dd-packages.git",
    "directory": "packages/craft"
  },
  "homepage": "https://github.com/Doman-Digital/dd-packages/tree/main/packages/craft#readme",
  "bugs": {
    "url": "https://github.com/Doman-Digital/dd-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
