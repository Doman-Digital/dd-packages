{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@domandigital/craft/art-direction.schema.json",
  "title": "art-direction.json",
  "description": "What a site decided, and why: the visitor's job, the structure decided from it, and how it looks. Every decision carries a reason: tokens from the client's real world, the job from the customer's own words, structure from the job. The reason rules are enforced by `craft direction validate`; this schema only checks the shape. Version 1 files (tokens only) still validate.",
  "type": "object",
  "required": [
    "version",
    "client",
    "brief",
    "sources",
    "choices"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string",
      "description": "Who, where, and what they do, in a sentence or two."
    },
    "job": {
      "type": "object",
      "description": "Version 2. What the visitor is trying to get done, in their words.",
      "properties": {
        "statement": {
          "type": "object",
          "required": [
            "verb",
            "object",
            "context"
          ],
          "properties": {
            "verb": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "context": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "functional": {
          "$ref": "#/$defs/jobPart"
        },
        "emotional": {
          "$ref": "#/$defs/jobPart"
        },
        "social": {
          "$ref": "#/$defs/jobPart"
        },
        "consideration": {
          "type": "object",
          "required": [
            "value",
            "because",
            "evidence"
          ],
          "properties": {
            "value": {
              "enum": [
                "low",
                "considered",
                "high"
              ]
            },
            "because": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "statement",
        "functional",
        "emotional",
        "social",
        "consideration",
        "objections",
        "language",
        "evidence"
      ]
    },
    "hierarchy": {
      "type": "object",
      "description": "Version 2. Keyed by page type.",
      "propertyNames": {
        "enum": [
          "home",
          "service",
          "about",
          "pricing",
          "booking",
          "contact",
          "article",
          "landing"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/page"
      },
      "required": [
        "home"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "livery",
              "shopfront",
              "signage",
              "packaging",
              "product",
              "uniform",
              "interior",
              "place",
              "material",
              "trade",
              "print",
              "photo",
              "founder",
              "review",
              "enquiry",
              "conversation",
              "search",
              "reference"
            ]
          },
          "note": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "colours": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lettering": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "For a reference: where it comes from. Never the client's own category."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "reference"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "category"
              ]
            }
          }
        ]
      }
    },
    "choices": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "accent",
          "ground",
          "display",
          "body",
          "shape",
          "motif",
          "signature"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "because",
          "evidence"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "because": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tell",
          "because"
        ],
        "properties": {
          "tell": {
            "type": "string"
          },
          "because": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jobPart": {
      "type": "object",
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "hero",
        "logos",
        "stats",
        "cards",
        "marquee",
        "text",
        "other",
        "cta-band",
        "footer-cta",
        "pricing",
        "testimonials",
        "faq",
        "process",
        "features",
        "team",
        "contact"
      ]
    },
    "page": {
      "type": "object",
      "required": [
        "primaryAction",
        "order",
        "lead",
        "journey"
      ],
      "properties": {
        "primaryAction": {
          "type": "object",
          "required": [
            "value",
            "positions",
            "because"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "positions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/role"
                  },
                  {
                    "enum": [
                      "header",
                      "sticky"
                    ]
                  }
                ]
              }
            },
            "because": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "order": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "because"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/role"
              },
              "because": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 2
        },
        "lead": {
          "type": "object",
          "required": [
            "value",
            "because"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "subordinate": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "because": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "journey": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "because"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "because": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 2
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "version": {
          "const": 1
        }
      }
    },
    {
      "properties": {
        "version": {
          "const": 2
        }
      },
      "required": [
        "job",
        "hierarchy"
      ]
    }
  ]
}
