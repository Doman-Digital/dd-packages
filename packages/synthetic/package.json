{
  "name": "@domandigital/synthetic",
  "version": "0.2.1",
  "private": false,
  "description": "Signed synthetic-submission protocol for Doman Digital client forms: sign and verify, replay guard, recipient lock, Turnstile config self-check, beacons and purge receipts. Web Crypto only.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test-vectors.json": "./test-vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "test-vectors.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^26.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doman-Digital/dd-packages.git",
    "directory": "packages/synthetic"
  },
  "homepage": "https://github.com/Doman-Digital/dd-packages/tree/main/packages/synthetic#readme",
  "bugs": {
    "url": "https://github.com/Doman-Digital/dd-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
