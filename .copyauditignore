# Files the house copy check skips in this repo, with the reason beside each.
# packages/craft/CHARACTER.md quotes every tell in its generated catalogue table; the
# quotes are the documentation, and the table is regenerated by `pnpm run docs`,
# so it cannot carry inline copy-ok marks.
packages/craft/CHARACTER.md
# COPY.md is the rulebook: it quotes every phrase it bans. The copy tells and their
# tests hold the same phrases as patterns and as fixtures that must fire, so a
# commit to them could never pass a check built from them (DOM-1016).
packages/craft/COPY.md
packages/craft/src/character/tells/copy.ts
packages/craft/src/__tests__/*.test.ts
